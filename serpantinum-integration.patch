diff --git a/home/config/hypr/hyprland.conf b/home/config/hypr/hyprland.conf
index c81fdcd..810116c 100644
--- a/home/config/hypr/hyprland.conf
+++ b/home/config/hypr/hyprland.conf
@@ -1,25 +1,88 @@
 # Teclado en español
 input {
     kb_layout = es
+    accel_profile = flat
+    touchpad {
+        natural_scroll = true
+        disable_while_typing = false
+    }
 }
 
+# Window look & feel expected by Serpantinum's theme (rounding, blur, panel/window animations)
+general {
+    border_size = 0
+    gaps_in = 4
+    gaps_out = 6
+    resize_on_border = true
+    extend_border_grab_area = 30
+}
+
+decoration {
+    rounding = 12
+    active_opacity = 1.0
+    inactive_opacity = 1.0
+    blur {
+        enabled = true
+        size = 8
+        passes = 2
+        new_optimizations = true
+    }
+    shadow {
+        enabled = false
+    }
+}
+
+misc {
+    focus_on_activate = false
+    font_family = JetBrains Mono
+    disable_hyprland_logo = true
+    disable_splash_rendering = true
+}
+
+bezier = myBezier, 0.05, 0.9, 0.1, 1.05
+
+animation = windows, 1, 5, myBezier, popin 80%
+animation = windowsOut, 1, 5, myBezier, popin 80%
+animation = layers, 1, 5, myBezier, fade
+animation = layersIn, 1, 5, myBezier, fade
+animation = layersOut, 1, 5, myBezier, fade
+animation = fade, 1, 5, myBezier
+animation = workspaces, 1, 5, myBezier, slide
+animation = specialWorkspaceIn, 1, 5, myBezier, fade
+animation = specialWorkspaceOut, 1, 5, myBezier, fade
+
 $mainMod = SUPER
 $terminal = kitty
 $fileManager = dolphin
 $menu = rofi -show drun
 
+# Auto-config for any connected monitor (preferred resolution/refresh, auto position)
+# "auto" scale overshot (too big) - starting at 1.25 as a middle ground.
+# To live-test other values without rebuilding: hyprctl keyword monitor ",preferred,auto,VALUE"
+# Once you find one you like, put that VALUE here permanently.
+monitor = , preferred, auto, 1.25
+
 # Autoarranque
-exec-once = waybar & dunst & hyprpaper &
-exec-once = systemctl --user start skwd-daemon.service
+# waybar/dunst/hyprpaper: replaced by Serpantinum's own bar, notifications and wallpaper engine
+# skwd-daemon.service: skwd-wall removed, Serpantinum now owns the wallpaper
+# Serpantinum starts itself via the "serpantinum" systemd --user service (programs.serpantinum.systemd.enable
+# in home/razen.nix), tied to graphical-session.target - no exec-once needed here.
+# If it doesn't come up on login (graphical-session.target not reached), uncomment this fallback:
+# exec-once = systemctl --user start serpantinum.service
+
+# Mic noise suppression for voice calls (Discord etc.)
+exec-once = systemctl --user enable --now easyeffects
 
 # Atajos principales
-bind = $mainMod, Q, exec, $terminal
+bind = $mainMod, RETURN, exec, $terminal
+bind = $mainMod, Q, exec, serpantinum reload
 bind = $mainMod, R, exec, $menu
-bind = $mainMod, C, killactive
 bind = $mainMod, M, exit
 bind = $mainMod, E, exec, $fileManager
-bind = $mainMod, V, togglefloating
+bind = $mainMod SHIFT, F, togglefloating
 bind = $mainMod, F, fullscreen
+bind = $mainMod, V, exec, serpantinum msg toggle volume
+bind = $mainMod, C, exec, serpantinum msg toggle clipboard
 
 # Foco
 bind = $mainMod, left, movefocus, l
@@ -45,6 +108,16 @@ bind = $mainMod SHIFT, 5, movetoworkspace, 5
 bindm = $mainMod, mouse:272, movewindow
 bindm = $mainMod, mouse:273, resizewindow
 
+# Mover/redimensionar ventanas con teclado
+bind = $mainMod CTRL, left, movewindow, l
+bind = $mainMod CTRL, right, movewindow, r
+bind = $mainMod CTRL, up, movewindow, u
+bind = $mainMod CTRL, down, movewindow, d
+binde = $mainMod SHIFT, left, resizeactive, -50 0
+binde = $mainMod SHIFT, right, resizeactive, 50 0
+binde = $mainMod SHIFT, up, resizeactive, 0 -50
+binde = $mainMod SHIFT, down, resizeactive, 0 50
+
 # Atajos para capturas de pantalla
 # Print: Seleccionar área y abrir directamente en Satty para editar/guardar
 bind = , Print, exec, grim -g "$(slurp)" - | satty --filename -
@@ -56,4 +129,27 @@ bind = SHIFT, Print, exec, grim -g "$(slurp)" - | wl-copy
 bind = CTRL, Print, exec, grim - | wl-copy
 
 # Atajos para cambiar el fondo de pantalla
-bind = $mainMod, W, exec, skwd-wall
\ No newline at end of file
+bind = $mainMod, W, exec, serpantinum msg toggle wallpaper
+
+# Serpantinum shell shortcuts (missing before - the launcher/lock features exist but had no keybind)
+bind = $mainMod, D, exec, serpantinum msg toggle launcher   # App launcher - separate from rofi on SUPER+R, keep whichever you prefer
+bind = $mainMod, L, exec, serpantinum lock                  # Lock screen
+bind = , XF86PowerOff, exec, serpantinum lock                # Power button also locks
+bind = $mainMod, H, exec, serpantinum msg toggle guide       # Settings panel (theme/bar/launcher/idle/notifications tabs)
+bind = ALT, F4, killactive
+
+# Brightness - now works thanks to hardware.i2c enabled via programs.serpantinum.enable
+bind = , XF86MonBrightnessDown, exec, serpantinum brightness lower
+bind = , XF86MonBrightnessUp, exec, serpantinum brightness raise
+
+# Media & volume keys
+bind = $mainMod, SPACE, exec, playerctl play-pause
+bind = , XF86AudioPlay, exec, playerctl play-pause
+bind = , XF86AudioPause, exec, playerctl play-pause
+bind = , XF86AudioMicMute, exec, serpantinum volume mic-toggle
+bind = , XF86AudioMute, exec, serpantinum volume mute-toggle
+binde = , XF86AudioLowerVolume, exec, serpantinum volume lower
+binde = , XF86AudioRaiseVolume, exec, serpantinum volume raise
+
+# 3-finger swipe to switch workspaces (touchpad only, harmless if you don't have one)
+gesture = 3, horizontal, workspace
\ No newline at end of file
